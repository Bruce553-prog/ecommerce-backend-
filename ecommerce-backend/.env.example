# Copy this file to ".env" and fill in real values. NEVER put real values in this template,
# and never commit ".env" to Git. This template (saved as ".env.example") is safe to commit.

# --- Core ---
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
# True only on your own computer. Must be False on the live server.
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# prefer locally. Use "require" in production.
DB_SSLMODE=prefer

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Frontend and CORS ---
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production only, e.g. https://api.thewct.co.ke
CSRF_TRUSTED_ORIGINS=

# --- Admin and login tokens ---
# Production: something only you know, e.g. wct-staff-8h3k/
ADMIN_URL=admin/
# Optional. Separate secret for signing login tokens. Defaults to SECRET_KEY.
JWT_SIGNING_KEY=

# --- Payments ---
# Local testing only. Must be False (or missing) in production.
SIMULATE_PAYMENTS=True

# --- Production HTTPS settings (leave out locally) ---
SECURE_SSL_REDIRECT=True
# True only if your host terminates HTTPS at a proxy (Render, Heroku, Nginx...)
USE_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=3600
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_AGE=28800

# --- M-Pesa (Daraja). Not used yet ---
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=